IBAL_ENGINE=browser
API_KEY=
CACHE_TTL_SECONDS=86400
CACHE_STALE_SECONDS=604800
IBAL_MIN_INTERVAL_SECONDS=20
IBAL_LIMIT_COOLDOWN_SECONDS=900
IBAL_MAX_LIVE_PER_HOUR=40
IBAL_MAX_LIVE_PER_DAY=80
IBAL_RECAPTCHA_RETRIES=3
IBAL_RECAPTCHA_WARMUP_MS=6000
# Proxies opcionales (rotación por consulta). Ejemplo:
# PROXY_LIST=http://user:pass@gate.provider.com:10001,http://user:pass@gate.provider.com:10002
PROXY_LIST=
PROXY_ROTATE=true
# reCAPTCHA v3 (necesario en Railway). Regístrate en capsolver.com o 2captcha.com
CAPTCHA_SOLVER=capsolver
CAPTCHA_API_KEY=tu_api_key_aqui
CAPTCHA_MIN_SCORE=0.7
# auto = navegador primero, solver en reintentos | off = solo navegador
CORS_ORIGINS=*